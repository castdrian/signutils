default_platform(:ios)

APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

def review_contact
  {
    first_name: ENV.fetch("REVIEW_CONTACT_FIRST_NAME"),
    last_name: ENV.fetch("REVIEW_CONTACT_LAST_NAME"),
    email_address: ENV.fetch("REVIEW_CONTACT_EMAIL"),
    phone_number: ENV.fetch("REVIEW_CONTACT_PHONE"),
    demo_user: "",
    demo_password: "",
    notes: File.read(File.expand_path("review_notes.txt", __dir__)).strip
  }
end

def find_app
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("#{APP_IDENTIFIER} has no app record in App Store Connect yet") unless app
  app
end

def connect_platform(platform)
  platform == "osx" ? Spaceship::ConnectAPI::Platform::MAC_OS : Spaceship::ConnectAPI::Platform::IOS
end

def wait_for_processed_build(platform:, version:, build:, timeout: 3600)
  app = find_app
  deadline = Time.now + timeout
  loop do
    found = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, version: version, build_number: build.to_s, platform: connect_platform(platform)
    ).first
    state = found&.processing_state
    UI.message("#{platform} build #{version} (#{build}): #{state || 'not visible yet'}")
    return found if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
    UI.user_error!("Build #{build} failed processing: #{state}") if %w[FAILED INVALID].include?(state)
    UI.user_error!("Timed out waiting for build #{build}") if Time.now > deadline
    sleep(30)
  end
end

def withdraw_from_review(platform:, timeout: 900)
  app = find_app
  submission = app.get_in_progress_review_submission(platform: connect_platform(platform))
  return unless submission
  UI.message("Cancelling review submission #{submission.id} (#{submission.state})")
  submission.cancel_submission
  deadline = Time.now + timeout
  until app.get_in_progress_review_submission(platform: connect_platform(platform)).nil?
    UI.user_error!("Timed out waiting for the review submission to be cancelled") if Time.now > deadline
    sleep(20)
  end
end

def submit(platform:, version:, build:, submit:, skip_metadata: false)
  key = api_key
  wait_for_processed_build(platform: platform, version: version, build: build) unless build.to_s.empty?
  withdraw_from_review(platform: platform) if submit
  deliver(
    api_key: key,
    platform: platform,
    app_version: version,
    build_number: build.to_s.empty? ? nil : build.to_s,
    skip_binary_upload: true,
    skip_metadata: skip_metadata,
    skip_screenshots: false,
    overwrite_screenshots: true,
    metadata_path: "./fastlane/metadata",
    screenshots_path: "./fastlane/screenshots/#{platform == 'osx' ? 'mac' : 'ios'}",
    app_review_information: review_contact,
    app_rating_config_path: "./fastlane/metadata/age_rating.json",
    force: true,
    submit_for_review: submit,
    automatic_release: true,
    reject_if_possible: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    submission_information: {
      add_id_info_uses_idfa: false,
      export_compliance_uses_encryption: false,
      content_rights_contains_third_party_content: false
    }
  )
end

platform :ios do
  desc "Upload metadata and screenshots and submit a processed iOS build for review"
  lane :release do |options|
    submit(platform: "ios", version: options.fetch(:version), build: options.fetch(:build, ""),
           submit: options.fetch(:submit, "true").to_s == "true")
  end
end

platform :mac do
  desc "Upload metadata and screenshots and submit a processed macOS build for review"
  lane :release do |options|
    submit(platform: "osx", version: options.fetch(:version), build: options.fetch(:build, ""),
           submit: options.fetch(:submit, "true").to_s == "true")
  end
end

desc "Check that the App Store Connect credentials and app record work"
lane :verify do
  api_key
  app = find_app
  UI.success("Found #{app.name} (#{app.id})")
end
